{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal shelf of UI pieces: live previews and code in several variants",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "icons": "node scripts/icons.mjs",
    "sync": "node scripts/sync.mjs",
    "check": "node scripts/sync.mjs --check",
    "dev": "node scripts/sync.mjs && astro dev",
    "build": "node scripts/sync.mjs && astro build",
    "preview": "astro preview",
    "new": "node scripts/new.mjs",
    "capture": "node scripts/capture.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "^7.3.5",
    "lucide-static": "^1.48.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "yaml": "^2.9.1"
  }
}
