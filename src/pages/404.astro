---
import App from '../layouts/App.astro';
import ShelfArt from '../components/ShelfArt.astro';
import { lurl } from '../lib/url';
import { t } from '../lib/i18n';
---
<App title={t('en', 'notFound')} lang="en" page="not-found">
  <div class="sh-empty sh-empty--page">
    <ShelfArt kind="lost" />
    <h1 class="sh-empty__title">{t('en', 'notFoundTitle')}</h1>
    <p class="sh-empty__text">{t('en', 'notFoundText')}</p>
    <a class="sh-btn sh-btn--primary" href={lurl('en', '')}>{t('en', 'openLibrary')}</a>
  </div>
</App>
