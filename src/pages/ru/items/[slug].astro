---
import ItemPage from '../../../components/ItemPage.astro';
import { allItems, type Item } from '../../../lib/items';

export async function getStaticPaths() {
  const items = await allItems();
  return items.map((item) => ({ params: { slug: item.id }, props: { item, items } }));
}
const { item, items } = Astro.props as { item: Item; items: Item[] };
---
<ItemPage item={item} items={items} lang="ru" />
