---
// The Shelf mark: two things standing on a plank and one below it. On the first page of a visit the plank
// appears and the things land on it one after another; under the pointer the tall one hops. Motion lives in
// shelf.css (.sh-logo); reduced motion shows the mark still.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<span class:list={['sh-sb__mark', 'sh-logo', cls]} aria-hidden="true">
  <svg viewBox="0 0 20 20" fill="currentColor">
    <rect class="sh-logo__a" x="3" y="3" width="5" height="7" rx="1.5" />
    <rect class="sh-logo__b" x="10" y="5.5" width="7" height="4.5" rx="1.5" opacity=".72" />
    <rect class="sh-logo__plank" x="2" y="11.5" width="16" height="1.5" rx=".75" />
    <rect class="sh-logo__c" x="4" y="14.5" width="8" height="3" rx="1.5" opacity=".72" />
  </svg>
</span>
