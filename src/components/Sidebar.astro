---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { GROUPS, TYPES, typeLabel, groupLabel } from '../lib/taxonomy';
import { COLLECTIONS, nameOf } from '../lib/curation';
import { lurl, url } from '../lib/url';
import { t, itemsWord, type Lang } from '../lib/i18n';
import type { Item } from '../lib/items';

interface Props {
  nav: string;
  items: Item[];
  lang: Lang;
}
const { nav, items, lang } = Astro.props;
const counts = new Map<string, number>();
for (const it of items) counts.set(it.data.type, (counts.get(it.data.type) ?? 0) + 1);
// Only kinds that have items, in groups that have kinds.
const groups = GROUPS.map((g) => ({ ...g, types: TYPES.filter((t) => t.group === g.id && counts.get(t.id)) })).filter((g) => g.types.length);
// Taste collections that have something in them, below the kinds, the way playlists sit under a music library.
const collections = COLLECTIONS.map((c) => ({ ...c, n: items.filter((i) => i.data.collections.includes(c.id)).length })).filter((c) => c.n);
const current = (key: string) => (nav === key ? 'page' : undefined);
const n = items.length;
---
<aside class="sh-sidebar" id="sidebar" aria-label="Shelf">
  {/* One button folds and unfolds the sidebar and never moves: at the right of the head, and in the rail it is the
      top icon, its arrow pointing the way the panel will go. */}
  <div class="sh-sb__head">
    <a class="sh-sb__brand" href={lurl(lang, '')}>
      <Logo />
      <span class="sh-sb__label sh-sb__wordmark">Shelf</span>
    </a>
    <button class="sh-sb__toggle sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-action="sidebar-toggle" aria-controls="sidebar" aria-label={t(lang, 'collapseSidebar')} data-tip={t(lang, 'collapseSidebar')} data-tip-kbd="mod+B">
      <Icon name="PanelLeftClose" class="sh-sb__toggle-close" /><Icon name="PanelLeftOpen" class="sh-sb__toggle-open" />
    </button>
  </div>

  <nav class="sh-sb__body" aria-label={t(lang, 'library')}>
    <div class="sh-sb__group">
      <button class="sh-sb__row" type="button" data-action="palette" data-tip={t(lang, 'search')} data-tip-kbd="mod+K">
        <Icon name="Search" /><span class="sh-sb__label">{t(lang, 'search')}</span><kbd class="sh-sb__kbd" data-mod-kbd="K">⌘K</kbd>
      </button>
      <a class="sh-sb__row" href={lurl(lang, '')} aria-current={current('all')} data-tip={t(lang, 'allItems')} data-nav="all">
        {nav === 'all' && <span class="sh-sb__pill"></span>}<Icon name="Library" /><span class="sh-sb__label">{t(lang, 'allItems')}</span><span class="sh-sb__count">{n}</span>
      </a>
      <a class="sh-sb__row" href={lurl(lang, 'favorites/')} aria-current={current('favorites')} data-tip={t(lang, 'favorites')} data-nav="favorites">
        {nav === 'favorites' && <span class="sh-sb__pill"></span>}<Icon name="Star" /><span class="sh-sb__label">{t(lang, 'favorites')}</span><span class="sh-sb__count" data-count="favorites"></span>
      </a>
      <a class="sh-sb__row" href={lurl(lang, 'coverage/')} aria-current={current('coverage')} data-tip={t(lang, 'coverage')} data-nav="coverage">
        {nav === 'coverage' && <span class="sh-sb__pill"></span>}<Icon name="ChartNoAxesColumn" /><span class="sh-sb__label">{t(lang, 'coverage')}</span>
      </a>
    </div>

    {groups.map((g) => (
      <section class="sh-sb__group" data-section={g.id}>
        <button class="sh-sb__heading" type="button" aria-expanded="true" data-action="section-toggle"><span class="sh-sb__label">{groupLabel(g, lang)}</span><Icon name="ChevronDown" class="sh-sb__chev" /></button>
        <div class="sh-sb__list">
          <div>
            {g.types.map((ty) => (
              <a class="sh-sb__row" href={lurl(lang, `type/${ty.id}/`)} aria-current={current(`type:${ty.id}`)} data-tip={typeLabel(ty, lang)} data-nav={`type:${ty.id}`}>
                {nav === `type:${ty.id}` && <span class="sh-sb__pill"></span>}<Icon name={ty.icon} /><span class="sh-sb__label">{typeLabel(ty, lang)}</span><span class="sh-sb__count">{counts.get(ty.id)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    {collections.length > 0 && (
      <section class="sh-sb__group" data-section="collections">
        <button class="sh-sb__heading" type="button" aria-expanded="true" data-action="section-toggle"><span class="sh-sb__label">{t(lang, 'collections')}</span><Icon name="ChevronDown" class="sh-sb__chev" /></button>
        <div class="sh-sb__list">
          <div>
            {collections.map((c) => (
              <a class="sh-sb__row" href={lurl(lang, `collection/${c.id}/`)} aria-current={current(`collection:${c.id}`)} data-tip={nameOf(c, lang)} data-nav={`collection:${c.id}`}>
                {nav === `collection:${c.id}` && <span class="sh-sb__pill"></span>}<Icon name={c.icon} /><span class="sh-sb__label">{nameOf(c, lang)}</span><span class="sh-sb__count">{c.n}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </nav>

  <div class="sh-sb__foot">
    <button class="sh-sb__profile" type="button" data-action="profile-menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="profile-menu" data-tip="Nikita Gorbachev">
      {/* A face with googly eyes (face.ts): it looks at the pointer, blinks, grins under it, falls asleep when left alone. */}
      <span class="sh-sb__avatar sh-face" aria-hidden="true" data-face>
        <svg viewBox="0 0 28 28" width="28" height="28" focusable="false">
          <g class="sh-face__eye" data-eye><circle class="sh-face__white" cx="9.3" cy="12.2" r="4.3" /><circle class="sh-face__pupil" cx="9.3" cy="12.2" r="2" /></g>
          <g class="sh-face__eye" data-eye><circle class="sh-face__white" cx="18.7" cy="12.2" r="4.3" /><circle class="sh-face__pupil" cx="18.7" cy="12.2" r="2" /></g>
          <path class="sh-face__mouth" d="M11.4 19.6 Q14 21.5 16.6 19.6" />
          <path class="sh-face__grin" d="M10.3 18.7 Q14 23.6 17.7 18.7" />
          <circle class="sh-face__snore" cx="14" cy="20.2" r="1.3" />
          <path class="sh-face__lid" d="M5.6 12 Q9.3 14.8 13 12 M15 12 Q18.7 14.8 22.4 12" />
        </svg>
        <span class="sh-face__z"><i>z</i><i>z</i><i>z</i></span>
      </span>
      <span class="sh-sb__label sh-sb__who"><span class="sh-sb__name">Nikita Gorbachev</span><span class="sh-sb__meta">{t(lang, 'itemsOnShelf', { n, items: itemsWord(lang, n) })}</span></span>
      <Icon name="ChevronsUpDown" class="sh-sb__label sh-sb__updown" />
    </button>
  </div>

  <div class="sh-sb__edge" data-action="sidebar-edge" role="separator" aria-orientation="vertical" aria-controls="sidebar" tabindex="0"
    aria-label={t(lang, 'sidebarEdge')} aria-valuemin="216" aria-valuemax="320" aria-valuenow="248"></div>
</aside>
<script is:inline>
  // An item page keeps the place you came from: opened from All items, Favorites or a collection, that row stays selected
  // (as in Mail or Linear) and the breadcrumb starts there. Runs before the page paints, so nothing jumps.
  // The last list you looked at is written by app.ts as { nav, url, y } when you leave it.
  (function () {
    var d = document.documentElement, item = d.dataset.itemPage;
    if (!item) return;
    try {
      var s = JSON.parse(sessionStorage.getItem("shelf:list") || "null");
      if (!s || typeof s.nav !== "string") return;
      var favs = JSON.parse(localStorage.getItem("shelf:favorites") || "[]");
      var cols = (d.dataset.collections || "").split(" ");
      var col = s.nav.indexOf("collection:") === 0 && cols.indexOf(s.nav.slice(11)) >= 0 ? s.nav.slice(11) : "";
      var from = s.nav === "all" ? "all" : s.nav === "favorites" && favs.indexOf(item) >= 0 ? "favorites" : col ? "collection" : s.nav === d.dataset.nav ? "type" : "";
      if (!from) return;
      d.dataset.from = from;
      if (col) d.dataset.fromCollection = col;
      if (from === "type") return;
      var sb = document.getElementById("sidebar");
      var cur = sb.querySelector('[aria-current="page"]'), to = sb.querySelector('[data-nav="' + s.nav + '"]');
      if (!to || to === cur) return;
      var pill = cur && cur.querySelector(".sh-sb__pill");
      if (cur) cur.removeAttribute("aria-current");
      to.setAttribute("aria-current", "page");
      if (pill) to.insertBefore(pill, to.firstChild);
    } catch (e) {}
  })();
</script>

<div class="sh-menu sh-profile-menu" id="profile-menu" role="dialog" aria-label={t(lang, 'settings')} hidden>
  <div class="sh-menu__label" id="pm-lang">{t(lang, 'language')}</div>
  <div class="sh-menu__seg">
    <div class="sh-seg sh-seg--sm" role="group" aria-labelledby="pm-lang" data-lang-switch>
      <button class="sh-seg__opt" type="button" data-value="en" lang="en" aria-pressed={lang === 'en' ? 'true' : 'false'}>English</button>
      <button class="sh-seg__opt" type="button" data-value="ru" lang="ru" aria-pressed={lang === 'ru' ? 'true' : 'false'}>Русский</button>
    </div>
  </div>
  <div class="sh-menu__label" id="pm-theme">{t(lang, 'appearance')}</div>
  <div class="sh-menu__seg">
    <div class="sh-seg sh-seg--sm" role="group" aria-labelledby="pm-theme" data-theme-switch>
      <button class="sh-seg__opt" type="button" data-value="system" aria-pressed="true">{t(lang, 'themeSystem')}</button>
      <button class="sh-seg__opt" type="button" data-value="light" aria-pressed="false">{t(lang, 'themeLight')}</button>
      <button class="sh-seg__opt" type="button" data-value="dark" aria-pressed="false">{t(lang, 'themeDark')}</button>
    </div>
  </div>
  <div class="sh-hide-narrow">
    <div class="sh-menu__label" id="pm-sidebar">{t(lang, 'sidebar')}</div>
    <div class="sh-menu__seg">
      <div class="sh-seg sh-seg--sm" role="group" aria-labelledby="pm-sidebar" data-sidebar-style>
        <button class="sh-seg__opt" type="button" data-value="floating" aria-pressed="true">{t(lang, 'floating')}</button>
        <button class="sh-seg__opt" type="button" data-value="attached" aria-pressed="false">{t(lang, 'attached')}</button>
      </div>
    </div>
  </div>
  <div class="sh-menu__sep"></div>
  <button class="sh-menu__item" type="button" data-action="sidebar-toggle"><Icon name="PanelLeft" /><span data-sidebar-label>{t(lang, 'collapseSidebar')}</span><span class="sh-menu__key" data-mod-kbd="B">⌘B</span></button>
  <button class="sh-menu__item" type="button" data-action="shortcuts"><Icon name="Keyboard" />{t(lang, 'shortcuts')}<span class="sh-menu__key">?</span></button>
  <div class="sh-menu__sep"></div>
  <a class="sh-menu__item" href="https://github.com/kloserock97-tech/shelf" target="_blank" rel="noopener"><Icon name="ExternalLink" />{t(lang, 'sourceOnGithub')}</a>
  <a class="sh-menu__item" href={url('THIRD_PARTY_NOTICES.txt')}><Icon name="Scale" />{t(lang, 'credits')}</a>
</div>
