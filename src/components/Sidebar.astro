---
import Icon from './Icon.astro';
import { TYPES } from '../lib/taxonomy';
import { url } from '../lib/url';
import type { Item } from '../lib/items';

interface Props {
  nav: string;
  items: Item[];
}
const { nav, items } = Astro.props;
const counts = new Map<string, number>();
for (const it of items) counts.set(it.data.type, (counts.get(it.data.type) ?? 0) + 1);
const types = TYPES.filter((t) => counts.get(t.id));
const current = (key: string) => (nav === key ? 'page' : undefined);
---
<nav class="sh-sidebar" id="sidebar" aria-label="Library">
  <a class="sh-brand" href={url('')}>Shelf</a>
  <label class="sh-search">
    <Icon name="Search" />
    <input class="sh-search__input" id="search" type="search" placeholder={`Search ${items.length} ${items.length === 1 ? 'item' : 'items'}`} aria-label="Search the shelf" autocomplete="off" spellcheck="false">
    <kbd class="sh-kbd" data-shortcut="palette">⌘K</kbd>
  </label>
  <div class="sh-nav">
    <a class="sh-nav__row" href={url('')} aria-current={current('all')}><Icon name="Library" />All items<span class="sh-nav__count">{items.length}</span></a>
    <a class="sh-nav__row" href={url('favorites/')} aria-current={current('favorites')}><Icon name="Star" />Favorites<span class="sh-nav__count" data-count="favorites"></span></a>
    <a class="sh-nav__row" href={url('recent/')} aria-current={current('recent')}><Icon name="Clock" />Recent</a>
  </div>
  {types.length > 0 && (
    <div class="sh-nav">
      <div class="sh-nav__label">Types</div>
      {types.map((t) => (
        <a class="sh-nav__row" href={url(`type/${t.id}/`)} aria-current={current(`type:${t.id}`)}><Icon name={t.icon} />{t.label}<span class="sh-nav__count">{counts.get(t.id)}</span></a>
      ))}
    </div>
  )}
  <div class="sh-sidebar__foot">
    <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm sh-sidebar__hide" type="button" data-action="sidebar-toggle" aria-label="Hide sidebar"><Icon name="PanelLeft" /></button>
    <span class="sh-spacer"></span>
    <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-action="theme" aria-label="Appearance: follow the system"><Icon name="Contrast" /></button>
  </div>
</nav>
