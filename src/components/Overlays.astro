---
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const TABS: { id: string; icon: string; key: 'finderNew' | 'finderKinds' | 'finderTasks' | 'finderCollections' | 'finderStack' }[] = [
  { id: 'new', icon: 'Sparkles', key: 'finderNew' },
  { id: 'kinds', icon: 'Shapes', key: 'finderKinds' },
  { id: 'tasks', icon: 'Target', key: 'finderTasks' },
  { id: 'collections', icon: 'Bookmark', key: 'finderCollections' },
  { id: 'stack', icon: 'CodeXml', key: 'finderStack' }
];
---
{/* Search, after Mobbin's search bar: recent picks, tabs on the left, tiles with covers on the right; typing turns
    the tabs into matches. finder.ts draws the chips and the panel; the ids stay palette/palette-input for the wiring. */}
<div class="sh-overlay sh-finder-overlay" id="palette" hidden>
  <div class="sh-palette sh-finder" role="dialog" aria-modal="true" aria-label={t(lang, 'paletteLabel')}>
    <div class="sh-finder__field">
      <Icon name="Search" class="sh-finder__lens" />
      <input class="sh-finder__input" id="palette-input" type="text" placeholder={t(lang, 'finderPlaceholder')} aria-label={t(lang, 'finderPlaceholder')}
        autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="finder-list" aria-autocomplete="list">
      {/* a round cross; Esc closes too, the footer says so */}
      <button class="sh-finder__close" type="button" aria-label={`${t(lang, 'close')} (Esc)`} data-finder-close><Icon name="X" /></button>
    </div>
    <div class="sh-finder__recent" data-finder-recent hidden></div>
    <div class="sh-finder__body">
      <div class="sh-finder__tabs" role="tablist" aria-label={t(lang, 'finderTabs')} aria-orientation="vertical">
        {TABS.map((tab, i) => (
          <button class="sh-finder__tab" type="button" role="tab" id={`ftab-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="finder-panel" tabindex="-1" data-tab={tab.id}>
            <Icon name={tab.icon} /><span class="sh-finder__tab-label" data-tab-label>{t(lang, tab.key)}</span><span class="sh-finder__tab-n" data-tab-n></span>
          </button>
        ))}
      </div>
      <div class="sh-finder__panel" id="finder-panel" role="tabpanel" aria-labelledby="ftab-new" tabindex="0" data-finder-panel>
        <div id="finder-list" role="listbox" aria-label={t(lang, 'results')} data-finder-list></div>
      </div>
    </div>
    <div class="sh-finder__foot" aria-hidden="true">
      <span><span class="sh-keys"><kbd class="sh-kbd">↑</kbd><kbd class="sh-kbd">↓</kbd><kbd class="sh-kbd">←</kbd><kbd class="sh-kbd">→</kbd></span>{t(lang, 'navigate')}</span>
      <span><kbd class="sh-kbd">Tab</kbd>{t(lang, 'finderTabs')}</span>
      <span><kbd class="sh-kbd">↵</kbd>{t(lang, 'open')}</span>
      <span><kbd class="sh-kbd">Esc</kbd>{t(lang, 'close')}</span>
    </div>
  </div>
</div>

<div class="sh-overlay sh-overlay--sheet" id="quicklook" hidden>
  <div class="sh-sheet" role="dialog" aria-modal="true" aria-labelledby="ql-title">
    <div class="sh-sheet__head">
      <div>
        <div class="sh-sheet__title" id="ql-title"></div>
        <div class="sh-sheet__sub" id="ql-sub"></div>
      </div>
      <div class="sh-sheet__actions">
        <a class="sh-btn sh-btn--sm" id="ql-demo" target="_blank" rel="noopener"><Icon name="ExternalLink" /><span>{t(lang, 'openDemo')}</span></a>
        <a class="sh-btn sh-btn--sm sh-btn--primary" id="ql-open"><span>{t(lang, 'open')}</span><Icon name="ChevronRight" /></a>
        <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-action="ql-close" aria-label={t(lang, 'close')}><Icon name="X" /></button>
      </div>
    </div>
    <div class="sh-stage" id="ql-stage">
      <div class="sh-stage__viewport" id="ql-viewport">
        <img class="sh-stage__poster" id="ql-poster" alt="" hidden>
      </div>
      <div class="sh-stage__status" id="ql-status" hidden>
        <span class="sh-spinner sh-spinner--lg" role="progressbar" aria-label={t(lang, 'loadingDemo')}><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        {t(lang, 'loadingDemo')}
      </div>
    </div>
  </div>
</div>

<div class="sh-overlay sh-overlay--sheet" id="shortcuts" hidden>
  <div class="sh-sheet sh-sheet--narrow" role="dialog" aria-modal="true" aria-labelledby="sc-title">
    <div class="sh-sheet__head">
      <h2 class="sh-sheet__title" id="sc-title">{t(lang, 'shortcuts')}</h2>
      <div class="sh-sheet__actions"><button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-action="shortcuts-close" aria-label={t(lang, 'close')}><Icon name="X" /></button></div>
    </div>
    <dl class="sh-shortcuts">
      <dt>{t(lang, 'scSearch')}</dt><dd><kbd class="sh-kbd" data-mod-kbd="K">⌘K</kbd></dd>
      <dt>{t(lang, 'scFilter')}</dt><dd><kbd class="sh-kbd">/</kbd></dd>
      <dt>{t(lang, 'scRandom')}</dt><dd><kbd class="sh-kbd">R</kbd></dd>
      <dt>{t(lang, 'scSidebar')}</dt><dd><kbd class="sh-kbd" data-mod-kbd="B">⌘B</kbd></dd>
      <dt>{t(lang, 'scGrid')}</dt><dd><kbd class="sh-kbd">←</kbd><kbd class="sh-kbd">↑</kbd><kbd class="sh-kbd">↓</kbd><kbd class="sh-kbd">→</kbd></dd>
      <dt>{t(lang, 'quickLook')}</dt><dd><kbd class="sh-kbd">{t(lang, 'spaceKey')}</kbd></dd>
      <dt>{t(lang, 'scOpen')}</dt><dd><kbd class="sh-kbd">↵</kbd></dd>
      <dt>{t(lang, 'scFav')}</dt><dd><kbd class="sh-kbd">F</kbd></dd>
      <dt>{t(lang, 'gridSize')}</dt><dd><kbd class="sh-kbd">[</kbd><kbd class="sh-kbd">]</kbd></dd>
      <dt>{t(lang, 'scCopyCode')}</dt><dd><kbd class="sh-kbd">C</kbd></dd>
      <dt>{t(lang, 'scCopyPrompt')}</dt><dd><kbd class="sh-kbd">P</kbd></dd>
      <dt>{t(lang, 'scVariant')}</dt><dd><kbd class="sh-kbd">1</kbd><kbd class="sh-kbd">2</kbd><kbd class="sh-kbd">3</kbd></dd>
      <dt>{t(lang, 'scThisList')}</dt><dd><kbd class="sh-kbd">?</kbd></dd>
    </dl>
  </div>
</div>

<div class="sh-tip" id="tip" role="tooltip" hidden></div>

<div class="sh-toast-layer" role="status" aria-live="polite" aria-atomic="true"><div class="sh-toast" id="toast" hidden></div></div>
