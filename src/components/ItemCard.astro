---
import Icon from './Icon.astro';
import { typeOf } from '../lib/taxonomy';
import { type Item, itemUrl, posterUrl, loopUrl, subtitle, isPrivate } from '../lib/items';
import { t, type Lang } from '../lib/i18n';

interface Props {
  item: Item;
  lang: Lang;
}
const { item, lang } = Astro.props;
const d = item.data;
const href = itemUrl(item, lang);
const poster = posterUrl(item);
const loop = loopUrl(item);
const priv = isPrivate(item);
---
<article class="sh-card" data-slug={item.id} data-tech={d.tech.join('|')} data-status={d.status} data-added={d.added.toISOString().slice(0, 10)} data-title={d.title}>
  <a class="sh-card__thumb" href={href} aria-label={d.title} data-loop={loop}>
    {poster ? (
      <img class="sh-card__media" src={poster} alt="" loading="lazy" decoding="async">
    ) : (
      <span class="sh-card__fallback"><Icon name={typeOf(d.type).icon} stroke={1.25} /></span>
    )}
    {(d.status === 'draft' || priv) && (
      <span class="sh-card__badges">
        {d.status === 'draft' && <span class="sh-badge sh-badge--glass sh-badge--draft">{t(lang, 'draft')}</span>}
        {priv && <span class="sh-badge sh-badge--glass"><Icon name="Lock" />{t(lang, 'private')}</span>}
      </span>
    )}
    <span class="sh-card__hint sh-badge sh-badge--glass" aria-hidden="true">{t(lang, 'quickLook')} <kbd class="sh-kbd">{t(lang, 'spaceKey')}</kbd></span>
  </a>
  <div class="sh-card__meta">
    <div class="sh-card__text">
      <a class="sh-card__title" href={href} tabindex="-1">{d.title}</a>
      <div class="sh-card__sub">{subtitle(item, lang)}</div>
    </div>
    <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm sh-card__fav sh-fav" type="button" aria-label={t(lang, 'favAdd', { title: d.title })} aria-pressed="false" data-fav={item.id}><Icon name="Star" /></button>
  </div>
</article>
