---
import Icon from './Icon.astro';
import ItemCard from './ItemCard.astro';
import ShelfArt from './ShelfArt.astro';
import { type Item, itemUrl, collectionUrl, posterUrl, subtitle } from '../lib/items';
import { GROUPS, TYPES, typeOf, typeAbout, typeLabel, groupLabel, type TypeDef } from '../lib/taxonomy';
import { t, itemsWord, type Lang } from '../lib/i18n';
import { lurl } from '../lib/url';
import { FACETS, VIEWS, defaultSort, defaultGroup, defaultView, sortsFor, groupsFor } from '../lib/facets';
import { COLLECTIONS, JOBS, nameOf, aboutOf, type CollectionDef } from '../lib/curation';

interface Props {
  title: string;
  items: Item[];
  lang: Lang;
  mode?: 'all' | 'type' | 'favorites' | 'collection';
  type?: TypeDef;
  collection?: CollectionDef;
}
const { title, items, lang, mode = 'all', type, collection } = Astro.props;
const techCount = new Map<string, number>();
for (const it of items) for (const tech of it.data.tech) techCount.set(tech, (techCount.get(tech) ?? 0) + 1);
const techs = [...techCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);
const filterable = mode !== 'favorites';
// All items opens in sections by kind group, a header over each (its name, how many, links to its kinds); library.ts
// keeps them in step with filters and the view menu. Rendered in that order already, so nothing moves when the script
// runs. Headers for grouping by task wait at the end of the grid until that grouping is picked.
const firstSort = defaultSort(mode);
const firstGroup = defaultGroup(mode);
const firstView = defaultView(mode);
const sectioned = mode !== 'type';
const jobHeads = JOBS.map((j) => ({ j, n: items.filter((i) => i.data.jobs[0] === j.id).length })).filter((x) => x.n);
const typeIndex = new Map(TYPES.map((ty, i) => [ty.id as string, i]));
const byKind = (a: Item, b: Item) => (typeIndex.get(a.data.type)! - typeIndex.get(b.data.type)!) || a.data.title.localeCompare(b.data.title, lang);
const sections = sectioned
  ? GROUPS.map((g) => {
      const inGroup = items.filter((i) => typeOf(i.data.type).group === g.id);
      const kinds = TYPES.filter((ty) => ty.group === g.id && inGroup.some((i) => i.data.type === ty.id));
      return { group: g, kinds, items: firstSort === 'type' ? [...inGroup].sort(byKind) : inGroup };
    }).filter((s) => s.items.length)
  : [];

// The library opens on one featured piece, shown big like a shelf in a shop window.
const FEATURED = ['garden-loader', 'glass-diorama', 'quiet-hill-hero', 'windcrest'];
const hero = mode === 'all'
  ? FEATURED.map((s) => items.find((i) => i.id === s)).find((i) => i && posterUrl(i)) ?? items.find((i) => posterUrl(i))
  : undefined;
// Collections on All items: a shelf of tiles under the featured piece, each a mosaic of three covers. The collection's
// own `cover` picks come first; if one is missing, members of other kinds fill in, then any member.
const rail = mode === 'all'
  ? COLLECTIONS.map((c) => {
      const members = items.filter((i) => i.data.collections.includes(c.id) && posterUrl(i));
      const art: Item[] = c.cover.map((s) => members.find((i) => i.id === s)).filter((i): i is Item => Boolean(i));
      for (const i of members) if (art.length < 3 && !art.some((a) => a.data.type === i.data.type)) art.push(i);
      for (const i of members) if (art.length < 3 && !art.includes(i)) art.push(i);
      return { c, n: items.filter((i) => i.data.collections.includes(c.id)).length, art: art.map((i) => posterUrl(i)!) };
    }).filter((x) => x.n)
  : [];
// A kind or a collection opens with a fan of its own covers: the colour comes from the content, not from the chrome.
const covers = mode === 'type' || mode === 'collection' ? items.map((i) => posterUrl(i)).filter((u): u is string => Boolean(u)).slice(0, 3) : [];
// Summaries and notes are written in Russian; say so to screen readers on English pages.
const contentLang = lang === 'ru' ? undefined : 'ru';
---
<header class="sh-toolbar">
  <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm sh-sidebar-toggle" type="button" data-action="sidebar-toggle" aria-label={t(lang, 'showSidebar')}><Icon name="PanelLeft" /></button>
  <h1 class="sh-toolbar__title">{title} <span class="sh-toolbar__count" data-count="visible">{filterable ? items.length : ''}</span></h1>
  <div class="sh-toolbar__spacer"></div>
  <div class="sh-zoom" title={t(lang, 'gridSize')}>
    <Icon name="LayoutGrid" class="sh-i--xs" />
    <input class="sh-slider" type="range" min="0" max="2" step="1" value="1" aria-label={t(lang, 'gridSize')} data-zoom>
    <Icon name="LayoutGrid" class="sh-i--md" />
  </div>
  <span class="sh-vsep"></span>
  <div class="sh-sortwrap">
    <button class="sh-btn sh-btn--ghost sh-btn--sm sh-sort" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="sort-menu" data-sort-trigger>
      <Icon name="ArrowUpDown" /><span data-sort-label>{firstView === 'shelves' ? t(lang, 'viewShelves') : firstGroup === 'section' ? t(lang, 'groupSection') : t(lang, 'newest')}</span><Icon name="ChevronDown" class="sh-i--xs sh-facet__chev" />
    </button>
    {/* One menu, two settings: how the cards are grouped, and their order inside each group. */}
    <div class="sh-menu sh-sortmenu" id="sort-menu" role="menu" aria-label={t(lang, 'view')} hidden data-sort-menu>
      <div role="group" aria-labelledby="view-as">
        <div class="sh-menu__label" id="view-as">{t(lang, 'showAs')}</div>
        {VIEWS.map((v) => (
          <button class="sh-menu__item" type="button" role="menuitemradio" aria-checked={v.id === firstView ? 'true' : 'false'} tabindex="-1" data-view={v.id}>
            <span class="sh-menu__check"><Icon name="Check" /></span>{t(lang, v.key)}
          </button>
        ))}
      </div>
      <div class="sh-menu__sep"></div>
      <div role="group" aria-labelledby="view-group">
        <div class="sh-menu__label" id="view-group">{t(lang, 'groupBy')}</div>
        {groupsFor(mode).map((g) => (
          <button class="sh-menu__item" type="button" role="menuitemradio" aria-checked={g.id === firstGroup ? 'true' : 'false'} tabindex="-1" data-group={g.id}>
            <span class="sh-menu__check"><Icon name="Check" /></span>{t(lang, g.key)}{g.id === 'job' && <span class="sh-menu__key">{t(lang, 'byMainTask')}</span>}
          </button>
        ))}
      </div>
      <div class="sh-menu__sep"></div>
      <div role="group" aria-labelledby="view-order">
        <div class="sh-menu__label" id="view-order">{t(lang, 'orderBy')}</div>
        {sortsFor(mode).map((s) => (
          <button class="sh-menu__item" type="button" role="menuitemradio" aria-checked={s.id === firstSort ? 'true' : 'false'} tabindex="-1" data-value={s.id}>
            <span class="sh-menu__check"><Icon name="Check" /></span>{t(lang, s.key)}
          </button>
        ))}
      </div>
    </div>
  </div>
  {/* The second row says what to show: words to look for in this list, then Type, Stack and Tags. The words search
      only this page's items (the sidebar's Search ⌘K goes anywhere on the shelf); library.ts keeps the count in the
      placeholder true, Favorites included. */}
  <div class="sh-filters" role="group" aria-label={t(lang, 'filters')} data-filters={filterable ? '' : undefined}>
    <label class="sh-search sh-search--filter">
      <Icon name="Search" />
      <input class="sh-search__input" id="search" type="search"
        placeholder={mode === 'favorites' ? t(lang, 'search') : t(lang, 'searchHere', { n: items.length, items: itemsWord(lang, items.length) })}
        aria-label={t(lang, 'searchHereLabel', { title })} autocomplete="off" spellcheck="false">
    </label>
    {filterable && (
      <div class="sh-filters__row">
        {FACETS.filter((f) => f.id !== 'type' || mode !== 'type').map((f) => (
          <button class="sh-facet" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="facet-pop" data-facet={f.id}>
            {t(lang, f.key)}<span class="sh-facet__n" data-facet-n hidden></span><Icon name="ChevronDown" class="sh-i--xs sh-facet__chev" />
          </button>
        ))}
        {techs.length > 1 && <span class="sh-vsep" aria-hidden="true"></span>}
        {techs.length > 1 && (
          <div class="sh-chips sh-chips--scroll" role="group" aria-label={t(lang, 'filterByTech')} data-filter="tech">
            {techs.map(([tech, n]) => (
              <button class="sh-chip" type="button" aria-pressed="false" data-value={tech}>{tech} <span class="sh-chip__count">{n}</span></button>
            ))}
          </div>
        )}
        <button class="sh-btn sh-btn--plain sh-btn--sm sh-filters__clear" type="button" data-action="clear-filters" hidden>{t(lang, 'clear')}</button>
      </div>
    )}
  </div>
</header>
{filterable && (
  <div class="sh-pop" id="facet-pop" role="dialog" aria-labelledby="facet-pop-title" hidden data-facet-pop>
    <div class="sh-pop__head">
      <span class="sh-pop__title" id="facet-pop-title" data-pop-title></span>
      <button class="sh-btn sh-btn--plain sh-btn--sm" type="button" hidden data-pop-clear>{t(lang, 'clear')}</button>
    </div>
    <label class="sh-search sh-pop__search" hidden data-pop-search-wrap>
      <Icon name="Search" />
      <input class="sh-search__input" type="search" autocomplete="off" spellcheck="false" data-pop-search>
    </label>
    <div class="sh-pop__list" data-pop-list></div>
    <div class="sh-pop__peek" aria-hidden="true" data-pop-peek></div>
    <div class="sh-pop__foot"><button class="sh-btn sh-btn--primary sh-pop__show" type="button" data-pop-show></button></div>
  </div>
)}
<div class="sh-visually-hidden" role="status" aria-live="polite" data-results-status></div>

{hero && (
  <section class="sh-hero" data-hero aria-labelledby="hero-title">
    <a class="sh-hero__art" href={itemUrl(hero, lang)} tabindex="-1" aria-hidden="true">
      <img src={posterUrl(hero)} alt="" decoding="async" fetchpriority="high">
    </a>
    <div class="sh-hero__text">
      <p class="sh-hero__eyebrow">{lang === 'ru' ? 'На витрине' : 'Featured'} · {subtitle(hero, lang)}</p>
      <h2 class="sh-hero__title" id="hero-title"><a href={itemUrl(hero, lang)}>{hero.data.title}</a></h2>
      <p class="sh-hero__summary" lang={contentLang}>{hero.data.summary}</p>
      <div class="sh-hero__actions">
        <a class="sh-btn sh-btn--primary" href={itemUrl(hero, lang)}>{t(lang, 'open')}<Icon name="ChevronRight" /></a>
        <button class="sh-btn sh-hero__ql" type="button" data-quicklook={hero.id}><Icon name="Play" />{t(lang, 'quickLook')}</button>
      </div>
    </div>
  </section>
)}

{rail.length > 0 && (
  <section class="sh-rail" data-rail aria-labelledby="rail-title">
    <div class="sh-rail__head">
      <h2 class="sh-grid__title" id="rail-title">{t(lang, 'collections')} <span class="sh-grid__count">{rail.length}</span></h2>
      <div class="sh-rail__nav">
        <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-rail-step="-1" aria-label={t(lang, 'railPrev')} aria-controls="rail-list" disabled><Icon name="ChevronLeft" /></button>
        <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm" type="button" data-rail-step="1" aria-label={t(lang, 'railNext')} aria-controls="rail-list"><Icon name="ChevronRight" /></button>
      </div>
    </div>
    <ul class="sh-rail__list" id="rail-list" data-rail-list>
      {rail.map(({ c, n, art }) => (
        <li class="sh-rail__item">
          <a class="sh-coltile" href={collectionUrl(c.id, lang)}>
            <span class:list={['sh-coltile__art', `sh-coltile__art--${Math.max(1, art.length)}`]} aria-hidden="true">
              {art.length
                ? art.map((src) => <img src={src} alt="" loading="lazy" decoding="async">)
                : <span class="sh-typehead__glyph"><Icon name={c.icon} stroke={1.5} /></span>}
            </span>
            <span class="sh-coltile__text">
              <span class="sh-coltile__name">{nameOf(c, lang)}</span>
              <span class="sh-coltile__meta"><span class="sh-coltile__n">{n} {itemsWord(lang, n)}</span> · {aboutOf(c, lang)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

{((mode === 'type' && type) || (mode === 'collection' && collection)) && (
  <section class="sh-typehead" aria-label={title}>
    <div class="sh-typehead__stack" aria-hidden="true" style={`--n:${Math.max(1, covers.length)}`}>
      {covers.length
        ? covers.map((src, i) => <img src={src} alt="" style={`--i:${i}`} loading="lazy" decoding="async">)
        : <span class="sh-typehead__glyph"><Icon name={(type ?? collection)!.icon} stroke={1.5} /></span>}
    </div>
    <div>
      <p class="sh-typehead__about">{type ? typeAbout(type, lang) : aboutOf(collection!, lang)}</p>
      <p class="sh-typehead__count">{items.length} {itemsWord(lang, items.length)}</p>
    </div>
  </section>
)}

<div class="sh-grid" id="grid" data-mode={mode}>
  {sectioned ? sections.map((s) => (
    <>
      <div class="sh-grid__head" data-group-head={`section:${s.group.id}`} hidden={firstGroup !== 'section'}>
        <h2 class="sh-grid__title">{groupLabel(s.group, lang)} <span class="sh-grid__count" data-group-count>{s.items.length}</span></h2>
        <nav class="sh-grid__kinds" aria-label={t(lang, 'groupKinds', { group: groupLabel(s.group, lang) })}>
          {s.kinds.map((ty) => <a class="sh-grid__kind" href={lurl(lang, `type/${ty.id}/`)} data-kind={ty.id}>{typeLabel(ty, lang)}</a>)}
        </nav>
      </div>
      {s.items.map((item) => <ItemCard item={item} lang={lang} />)}
    </>
  )) : items.map((item) => <ItemCard item={item} lang={lang} />)}
  {jobHeads.map(({ j, n }) => (
    <div class="sh-grid__head" data-group-head={`job:${j.id}`} hidden>
      <h2 class="sh-grid__title">{nameOf(j, lang)} <span class="sh-grid__count" data-group-count>{n}</span></h2>
      <p class="sh-grid__about">{aboutOf(j, lang)}</p>
    </div>
  ))}
</div>
{/* icons for the arrows of shelves, which library.ts builds */}
<template data-arrow="-1"><Icon name="ChevronLeft" /></template>
<template data-arrow="1"><Icon name="ChevronRight" /></template>
<div class="sh-empty" data-empty="favorites" hidden>
  <ShelfArt kind="favorites" />
  <p class="sh-empty__title">{t(lang, 'noFavTitle')}</p>
  <p class="sh-empty__text">{t(lang, 'noFavText')}</p>
</div>
<div class="sh-empty" data-empty="search" hidden>
  <ShelfArt kind="search" />
  <p class="sh-empty__title" data-empty-title={t(lang, 'noResultsTitle')} data-empty-title-filters={t(lang, 'noMatchTitle')}></p>
  <p class="sh-empty__text" data-empty-text={t(lang, 'noResultsText')} data-empty-text-filters={t(lang, 'noMatchText')}>{t(lang, 'noResultsText')}</p>
  <div class="sh-empty__fixes" data-empty-fixes></div>
  <button class="sh-btn" type="button" data-action="clear-filters">{t(lang, 'clearFilters')}</button>
</div>
<div class="sh-empty" data-empty="none" hidden>
  <ShelfArt kind="empty" />
  <p class="sh-empty__title">{t(lang, 'emptyTitle')}</p>
  <p class="sh-empty__text">{t(lang, 'emptyText')}</p>
</div>
