---
import Icon from './Icon.astro';
import ItemCard from './ItemCard.astro';
import ShelfArt from './ShelfArt.astro';
import { type Item, itemUrl, posterUrl, subtitle } from '../lib/items';
import { typeOf, typeAbout, type TypeDef } from '../lib/taxonomy';
import { t, itemsWord, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  items: Item[];
  lang: Lang;
  mode?: 'all' | 'type' | 'favorites';
  type?: TypeDef;
}
const { title, items, lang, mode = 'all', type } = Astro.props;
const techCount = new Map<string, number>();
for (const it of items) for (const tech of it.data.tech) techCount.set(tech, (techCount.get(tech) ?? 0) + 1);
const techs = [...techCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);
const filterable = mode === 'all' || mode === 'type';

// The library opens on one featured piece, shown big like a shelf in a shop window.
const FEATURED = ['garden-loader', 'glass-diorama', 'quiet-hill-hero', 'windcrest'];
const hero = mode === 'all'
  ? FEATURED.map((s) => items.find((i) => i.id === s)).find((i) => i && posterUrl(i)) ?? items.find((i) => posterUrl(i))
  : undefined;
// A kind opens with a fan of its own covers: the colour comes from the content, not from the chrome.
const covers = mode === 'type' ? items.map((i) => posterUrl(i)).filter((u): u is string => Boolean(u)).slice(0, 3) : [];
// Summaries and notes are written in Russian; say so to screen readers on English pages.
const contentLang = lang === 'ru' ? undefined : 'ru';
---
<header class="sh-toolbar">
  <button class="sh-btn sh-btn--ghost sh-btn--icon sh-btn--sm sh-sidebar-toggle" type="button" data-action="sidebar-toggle" aria-label={t(lang, 'showSidebar')}><Icon name="PanelLeft" /></button>
  <h1 class="sh-toolbar__title">{title} <span class="sh-toolbar__count" data-count="visible">{mode === 'all' || mode === 'type' ? items.length : ''}</span></h1>
  {filterable && techs.length > 1 && (
    <div class="sh-chips sh-chips--scroll" role="group" aria-label={t(lang, 'filterByTech')} data-filter="tech">
      <button class="sh-chip" type="button" aria-pressed="true" data-value="">{t(lang, 'all')}</button>
      {techs.map(([tech, n]) => (
        <button class="sh-chip" type="button" aria-pressed="false" data-value={tech}>{tech} <span class="sh-chip__count">{n}</span></button>
      ))}
    </div>
  )}
  <div class="sh-toolbar__spacer"></div>
  <label class="sh-search sh-search--toolbar">
    <Icon name="Search" />
    <input class="sh-search__input" id="search" type="search" placeholder={t(lang, 'filter')} aria-label={t(lang, 'filterPage', { title })} autocomplete="off" spellcheck="false">
  </label>
  <div class="sh-zoom" title={t(lang, 'gridSize')}>
    <Icon name="LayoutGrid" class="sh-i--xs" />
    <input class="sh-slider" type="range" min="0" max="2" step="1" value="1" aria-label={t(lang, 'gridSize')} data-zoom>
    <Icon name="LayoutGrid" class="sh-i--md" />
  </div>
  <span class="sh-vsep"></span>
  <div class="sh-seg sh-seg--sm" role="group" aria-label={t(lang, 'sort')} data-sort>
    <button class="sh-seg__opt" type="button" data-value="new" aria-pressed="true">{t(lang, 'newest')}</button>
    <button class="sh-seg__opt" type="button" data-value="name" aria-pressed="false">{t(lang, 'az')}</button>
  </div>
</header>

{hero && (
  <section class="sh-hero" data-hero aria-labelledby="hero-title">
    <a class="sh-hero__art" href={itemUrl(hero, lang)} tabindex="-1" aria-hidden="true">
      <img src={posterUrl(hero)} alt="" decoding="async" fetchpriority="high">
    </a>
    <div class="sh-hero__text">
      <p class="sh-hero__eyebrow">{lang === 'ru' ? 'На витрине' : 'Featured'} · {subtitle(hero, lang)}</p>
      <h2 class="sh-hero__title" id="hero-title"><a href={itemUrl(hero, lang)}>{hero.data.title}</a></h2>
      <p class="sh-hero__summary" lang={contentLang}>{hero.data.summary}</p>
      <div class="sh-hero__actions">
        <a class="sh-btn sh-btn--primary" href={itemUrl(hero, lang)}>{t(lang, 'open')}<Icon name="ChevronRight" /></a>
        <button class="sh-btn sh-hero__ql" type="button" data-quicklook={hero.id}><Icon name="Eye" />{t(lang, 'quickLook')}</button>
      </div>
    </div>
  </section>
)}

{mode === 'type' && type && (
  <section class="sh-typehead" aria-label={title}>
    <div class="sh-typehead__stack" aria-hidden="true" style={`--n:${Math.max(1, covers.length)}`}>
      {covers.length
        ? covers.map((src, i) => <img src={src} alt="" style={`--i:${i}`} loading="lazy" decoding="async">)
        : <span class="sh-typehead__glyph"><Icon name={type.icon} stroke={1.5} /></span>}
    </div>
    <div>
      <p class="sh-typehead__about">{typeAbout(type, lang)}</p>
      <p class="sh-typehead__count">{items.length} {itemsWord(lang, items.length)}</p>
    </div>
  </section>
)}

<div class="sh-grid" id="grid" data-mode={mode}>
  {items.map((item) => <ItemCard item={item} lang={lang} />)}
</div>
<div class="sh-empty" data-empty="favorites" hidden>
  <ShelfArt kind="favorites" />
  <p class="sh-empty__title">{t(lang, 'noFavTitle')}</p>
  <p class="sh-empty__text">{t(lang, 'noFavText')}</p>
</div>
<div class="sh-empty" data-empty="search" hidden>
  <ShelfArt kind="search" />
  <p class="sh-empty__title" data-empty-title={t(lang, 'noResultsTitle')}></p>
  <p class="sh-empty__text">{t(lang, 'noResultsText')}</p>
  <button class="sh-btn" type="button" data-action="clear-filters">{t(lang, 'clearFilters')}</button>
</div>
<div class="sh-empty" data-empty="none" hidden>
  <ShelfArt kind="empty" />
  <p class="sh-empty__title">{t(lang, 'emptyTitle')}</p>
  <p class="sh-empty__text">{t(lang, 'emptyText')}</p>
</div>
