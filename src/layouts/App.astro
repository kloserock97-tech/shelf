---
import '@fontsource-variable/onest';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/shelf.css';
import '../styles/code.css';
import Sidebar from '../components/Sidebar.astro';
import Overlays from '../components/Overlays.astro';
import { allItems, indexEntry } from '../lib/items';
import { url } from '../lib/url';
import { t, type Lang } from '../lib/i18n';

interface Props {
  title?: string;
  nav?: string;
  lang?: Lang;
  page?: 'not-found';
  item?: string;
}
const { title, nav = '', lang = 'en', page, item } = Astro.props;
const items = await allItems();
const index = JSON.stringify(items.map((e) => indexEntry(e, lang))).replace(/</g, '\\u003c');

// The same page in the other language: /shelf/<path> and /shelf/ru/<path>. The not-found page has no twin
// at the same address (GitHub Pages serves one 404.html), so English points at /ru/404/ and Russian at the library.
const base = url('');
const here = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : '';
const rel = here.replace(/^ru\//, '');
const alt = page === 'not-found' ? (lang === 'en' ? url('ru/404/') : url('')) : lang === 'en' ? url(`ru/${rel}`) : url(rel);
---
<!doctype html>
<html lang={lang} data-alt={alt} data-page={page} data-nav={nav || undefined} data-item-page={item}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <meta name="color-scheme" content="light dark">
    <title>{title ? `${title} · Shelf` : 'Shelf'}</title>
    {/* The mark everywhere a browser shows a site: the tab (SVG, ICO for older ones), tiles and Safari (touch icon),
        the manifest's icons. Built by npm run icons. */}
    <link rel="icon" href={url('favicon.ico')} sizes="32x32">
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')}>
    <link rel="manifest" href={url('site.webmanifest')}>
    <link rel="alternate" hreflang={lang === 'en' ? 'ru' : 'en'} href={alt}>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // A language chosen in the profile menu wins over the address: go to the twin page before anything paints.
        try {
          var want = localStorage.getItem("shelf:lang");
          var lost = d.dataset.page === "not-found";
          if (lost && d.lang === "en" && (want === "ru" || location.pathname.indexOf("/ru/") >= 0)) { location.replace(d.dataset.alt); return; }
          if (!lost && (want === "en" || want === "ru") && want !== d.lang) { location.replace(d.dataset.alt + location.search + location.hash); return; }
        } catch (e) {}
        d.classList.add("sb-noanim");
        try {
          var t = localStorage.getItem("shelf:theme");
          if (t === "light" || t === "dark") d.dataset.theme = t;
          if (localStorage.getItem("shelf:sidebar") === "rail") d.classList.add("sidebar-rail");
          if (localStorage.getItem("shelf:sidebar-style") === "attached") d.classList.add("sb-attached");
          var w = Number(localStorage.getItem("shelf:sidebar-width"));
          if (w >= 216 && w <= 320) d.style.setProperty("--sidebar-width", w + "px");
          var z = localStorage.getItem("shelf:zoom");
          if (z) d.style.setProperty("--card-min-width", z + "px");
          var s = JSON.parse(localStorage.getItem("shelf:sections") || "[]");
          if (Array.isArray(s)) s.forEach(function (id) { d.classList.add("sec-closed-" + id); });
          if (!sessionStorage.getItem("shelf:intro")) { d.classList.add("sb-intro"); sessionStorage.setItem("shelf:intro", "1"); }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-base={url('')}>
    <a class="sh-skip" href="#main">{t(lang, 'skip')}</a>
    <div class="sh-app">
      <Sidebar nav={nav} items={items} lang={lang} />
      <main class="sh-main" id="main" tabindex="-1"><slot /></main>
    </div>
    <div class="sh-sidebar-scrim" data-action="sidebar-close"></div>
    <Overlays lang={lang} />
    <script type="application/json" id="shelf-index" set:html={index}></script>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
